{
  "expo": {
    "name": "OffersOffer",
    "slug": "TOY-mobile-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "offersapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toy.offersapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OffersOffer uses your location to show offers and shops near you.",
        "UIBackgroundModes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.toy.offersapp",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OffersOffer uses your location to show offers and shops near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f59e0b",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OffersOffer uses your photos to set a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9173ec0e-409f-44b6-ac61-0596005f5ce9"
      }
    },
    "owner": "timosh17"
  }
}
