# Local development only. Copy to .env and fill in.
#
# .env is gitignored, and EAS builds from git — so a cloud build never sees
# this file. Shipping builds get their API URL from `eas.json`
# (build.preview.env and build.production.env) and their secrets from EAS
# environment variables. Changing this file affects your machine and nothing
# else.
#
# EXPO_PUBLIC_* vars are inlined when the bundle is built, so restart the
# bundler after editing.

# The API this app talks to. A phone resolves "localhost" to itself, so on a
# physical device this must be the dev machine's LAN address.
# Production is https://offersoffer.in/api — set in eas.json, not here.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Maps Android key for the Near Me map (react-native-maps). Optional:
# without it the map falls back to a list rather than crashing.
# Enable "Maps SDK for Android" in Google Cloud, create an API key, then
# restrict it to package com.toy.offersapp with your signing SHA-1.
#
# This is a secret and must NOT go in eas.json, which is committed. For builds,
# set it as an EAS environment variable of the same name:
#   eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --scope project
GOOGLE_MAPS_ANDROID_API_KEY=
